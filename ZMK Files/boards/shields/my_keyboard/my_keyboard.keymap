#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            // Row 0: Number/symbol row
            &kp ESC   &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
            // Row 1: Home row
            &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
            // Row 2: Bottom alpha row
            &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
            // Row 3: Modifier row
            &kp LCTRL &kp LGUI &kp LALT &kp MINUS &kp EQUAL &kp LBKT    &kp RBKT &kp BSLH &kp GRAVE &kp RALT &kp RGUI &kp RCTRL
            // Row 4 (Thumb Cluster: 3 keys per side)
                                &mo 1 &kp SPACE &kp RET    &kp RET &kp SPACE &mo 1
            >;
        };

        fn_layer {
            bindings = <
            // Row 0
            &kp GRAVE &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp F6  &kp F7  &kp F8   &kp F9   &kp F10   &kp DEL
            // Row 1
            &trans    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8   &kp N9   &kp N0    &kp F11
            // Row 2
            &trans    &trans  &trans  &trans  &trans  &trans     &trans  &trans  &kp LBKT &kp RBKT &kp BSLH  &kp F12
            // Row 3
            &trans    &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans   &trans   &trans    &trans
            // Row 4
                              &trans  &trans  &trans             &trans  &trans  &trans
            >;
        };
    };
};
