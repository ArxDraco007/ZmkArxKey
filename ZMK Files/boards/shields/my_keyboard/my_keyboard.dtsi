#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
        /* Row 0: 12 keys */
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        /* Row 1: 12 keys */
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        /* Row 2: 12 keys */
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        /* Row 3: 12 keys */
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        /* Row 4: 6 thumb keys (3 per side) */
                                RC(4,3) RC(4,4) RC(4,5)    RC(4,6) RC(4,7) RC(4,8)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot   rx   ry
            = <&key_physical_attrs 100 100    0    0       0    0    0>  /* R0C0  ESC       */
            , <&key_physical_attrs 100 100  100    0       0    0    0>  /* R0C1  Q         */
            , <&key_physical_attrs 100 100  200    0       0    0    0>  /* R0C2  W         */
            , <&key_physical_attrs 100 100  300    0       0    0    0>  /* R0C3  E         */
            , <&key_physical_attrs 100 100  400    0       0    0    0>  /* R0C4  R         */
            , <&key_physical_attrs 100 100  500    0       0    0    0>  /* R0C5  T         */
            , <&key_physical_attrs 100 100  700    0       0    0    0>  /* R0C6  Y         */
            , <&key_physical_attrs 100 100  800    0       0    0    0>  /* R0C7  U         */
            , <&key_physical_attrs 100 100  900    0       0    0    0>  /* R0C8  I         */
            , <&key_physical_attrs 100 100 1000    0       0    0    0>  /* R0C9  O         */
            , <&key_physical_attrs 100 100 1100    0       0    0    0>  /* R0C10 P         */
            , <&key_physical_attrs 100 100 1200    0       0    0    0>  /* R0C11 BSPC      */
            , <&key_physical_attrs 100 100    0  100       0    0    0>  /* R1C0  TAB       */
            , <&key_physical_attrs 100 100  100  100       0    0    0>  /* R1C1  A         */
            , <&key_physical_attrs 100 100  200  100       0    0    0>  /* R1C2  S         */
            , <&key_physical_attrs 100 100  300  100       0    0    0>  /* R1C3  D         */
            , <&key_physical_attrs 100 100  400  100       0    0    0>  /* R1C4  F         */
            , <&key_physical_attrs 100 100  500  100       0    0    0>  /* R1C5  G         */
            , <&key_physical_attrs 100 100  700  100       0    0    0>  /* R1C6  H         */
            , <&key_physical_attrs 100 100  800  100       0    0    0>  /* R1C7  J         */
            , <&key_physical_attrs 100 100  900  100       0    0    0>  /* R1C8  K         */
            , <&key_physical_attrs 100 100 1000  100       0    0    0>  /* R1C9  L         */
            , <&key_physical_attrs 100 100 1100  100       0    0    0>  /* R1C10 SEMI      */
            , <&key_physical_attrs 100 100 1200  100       0    0    0>  /* R1C11 SQT       */
            , <&key_physical_attrs 100 100    0  200       0    0    0>  /* R2C0  LSHFT     */
            , <&key_physical_attrs 100 100  100  200       0    0    0>  /* R2C1  Z         */
            , <&key_physical_attrs 100 100  200  200       0    0    0>  /* R2C2  X         */
            , <&key_physical_attrs 100 100  300  200       0    0    0>  /* R2C3  C         */
            , <&key_physical_attrs 100 100  400  200       0    0    0>  /* R2C4  V         */
            , <&key_physical_attrs 100 100  500  200       0    0    0>  /* R2C5  B         */
            , <&key_physical_attrs 100 100  700  200       0    0    0>  /* R2C6  N         */
            , <&key_physical_attrs 100 100  800  200       0    0    0>  /* R2C7  M         */
            , <&key_physical_attrs 100 100  900  200       0    0    0>  /* R2C8  COMMA     */
            , <&key_physical_attrs 100 100 1000  200       0    0    0>  /* R2C9  DOT       */
            , <&key_physical_attrs 100 100 1100  200       0    0    0>  /* R2C10 FSLH      */
            , <&key_physical_attrs 100 100 1200  200       0    0    0>  /* R2C11 RSHFT     */
            , <&key_physical_attrs 100 100    0  300       0    0    0>  /* R3C0  LCTRL     */
            , <&key_physical_attrs 100 100  100  300       0    0    0>  /* R3C1  LGUI      */
            , <&key_physical_attrs 100 100  200  300       0    0    0>  /* R3C2  LALT      */
            , <&key_physical_attrs 100 100  300  300       0    0    0>  /* R3C3  MINUS     */
            , <&key_physical_attrs 100 100  400  300       0    0    0>  /* R3C4  EQUAL     */
            , <&key_physical_attrs 100 100  500  300       0    0    0>  /* R3C5  LBKT      */
            , <&key_physical_attrs 100 100  700  300       0    0    0>  /* R3C6  RBKT      */
            , <&key_physical_attrs 100 100  800  300       0    0    0>  /* R3C7  BSLH      */
            , <&key_physical_attrs 100 100  900  300       0    0    0>  /* R3C8  GRAVE     */
            , <&key_physical_attrs 100 100 1000  300       0    0    0>  /* R3C9  RALT      */
            , <&key_physical_attrs 100 100 1100  300       0    0    0>  /* R3C10 RGUI      */
            , <&key_physical_attrs 100 100 1200  300       0    0    0>  /* R3C11 RCTRL     */
            , <&key_physical_attrs 100 100  300  425       0    0    0>  /* R4C3  MO 1      */
            , <&key_physical_attrs 100 100  400  425       0    0    0>  /* R4C4  SPACE     */
            , <&key_physical_attrs 100 100  500  425       0    0    0>  /* R4C5  RET       */
            , <&key_physical_attrs 100 100  700  425       0    0    0>  /* R4C6  RET       */
            , <&key_physical_attrs 100 100  800  425       0    0    0>  /* R4C7  SPACE     */
            , <&key_physical_attrs 100 100  900  425       0    0    0>  /* R4C8  MO 1      */
            ;
    };
};
